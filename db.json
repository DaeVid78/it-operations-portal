    function launchNativeApp(appKey) {
      const saved = JSON.parse(localStorage.getItem('cctv_app_cfg') || '{}');
      const apps = {
        seetong: { androidPkg: 'com.seetong.app', iosScheme: 'seetong://', pcProtocol: 'seetong://' },
        imou: { androidPkg: 'com.mm.android.lc', iosScheme: 'imoulife://', pcProtocol: 'imoulife://' },
        hikconnect: { androidPkg: saved.hik || 'com.connect.enduser', iosScheme: 'hikconnect://', pcProtocol: 'hikconnect://' }
      };
      const target = apps[appKey];
      if (!target) return;
      const ua = navigator.userAgent || '';
      if (/Android/i.test(ua)) {
        window.location.href = `intent://#Intent;action=android.intent.action.MAIN;category=android.intent.category.LAUNCHER;package=${target.androidPkg};end`;
      } else if (/iPhone|iPad|iPod/i.test(ua)) {
        window.location.href = target.iosScheme;
      } else {
        window.location.href = target.pcProtocol;
      }
    }

