    function getKPISummaryRows() {
      return db.users.map(u => {
        const cctv = db.dailyChecks.filter(c => c.by === u.name && c.type === 'CCTV').length;
        const net = db.dailyChecks.filter(c => c.by === u.name && c.type === 'Network').length;
        const tasks = db.tasks.filter(t => t.assigned === u.name && t.status === 'Completed').length;
        const inc = db.incidents.filter(i => i.by === u.name).length;
        const score = (cctv + net + tasks) === 0 ? 0 : Math.min(100, Math.round(((cctv + net + tasks) / 30) * 100));
        return { name: u.name, role: u.role, cctv, net, tasks, inc, score: `${score}%` };
      });
    }

