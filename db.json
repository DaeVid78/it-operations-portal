    // --- IMAGE COMPRESSION ---
    function handleGalleryUpload(e, type) {
      Array.from(e.target.files).forEach(file => {
        const reader = new FileReader();
        reader.onload = (ev) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            const maxW = 900;
            const scale = img.width > maxW ? maxW / img.width : 1;
            canvas.width = img.width * scale;
            canvas.height = img.height * scale;
            canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
            const compressed = canvas.toDataURL('image/jpeg', 0.78);
            (type === 'cctv' ? cctvImages : netImages).push(compressed);
            renderGallery(type);
          };
          img.src = ev.target.result;
        };
        reader.readAsDataURL(file);
      });
    }

    function renderGallery(type) {
      const list = type === 'cctv' ? cctvImages : netImages;
      document.getElementById(`${type}-gallery`).innerHTML = list.map((src, i) => `
        <div class="gallery-item"><img src="${src}"><button type="button" onclick="removeGalleryImage('${type}', ${i})" class="gallery-remove"><i class="fa-solid fa-xmark"></i></button></div>
      `).join('');
    }

    function removeGalleryImage(type, idx) { (type === 'cctv' ? cctvImages : netImages).splice(idx, 1); renderGallery(type); }

    function viewCheckPhotos(idx) {
      const c = db.dailyChecks[idx];
      if (!c) return;
      document.getElementById('photo-modal-title').innerText = `${c.ticket || c.type} - Evidence (${(c.images || []).length} Photos)`;
      document.getElementById('photo-modal-meta').innerHTML = `
        <b>Date:</b> ${c.date} | <b>Checked By:</b> ${c.by} | <b>Status:</b> ${c.status}<br>
        <b>Details:</b> ${c.details || '-'}<br><b>Remark:</b> ${c.remark}
      `;
      const imgs = c.images || [];
      document.getElementById('photo-modal-grid').innerHTML = imgs.length
        ? imgs.map((src, i) => `
            <div style="border:1px solid #e2e8f0;border-radius:10px;padding:8px;background:#f8fafc;">
              <img src="${src}" style="width:100%;border-radius:6px;display:block;">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-top:6px;">
                <span style="font-size:11px;color:#64748b;">Photo #${i + 1}</span>
                <a href="${src}" download="${c.ticket || 'check'}-photo-${i + 1}.jpg" class="btn btn-outline" style="text-decoration:none;">Download Image</a>
              </div>
            </div>`).join('')
        : `<div class="empty-row">No screenshots attached to this record.</div>`;
      document.getElementById('photo-modal').classList.remove('hidden');
    }

    // --- EXPORT FUNCTIONS ---
    function downloadFile(content, filename, mime) {
