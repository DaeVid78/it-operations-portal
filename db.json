    async function resetToCleanProduction() {
      if (!isManager()) return requireManagerAlert();
      if (!confirm('စာရင်းများအားလုံးကို ဖျက်ပြီး အသစ်စက်စက် (0) မှ ပြန်စရန် သေချာပါသလား?')) return;
      db.cctvCount = 0; db.networkCount = 0; db.dailyChecks = []; db.tasks = []; db.incidents = [];
      db.schemaVersion = DB_SCHEMA_VERSION;
      localStorage.setItem('it_portal_db', JSON.stringify(db));
      renderAll(); await pushToGitHub();
    }

    function isManager() { return currentUser && currentUser.role === 'IT Manager'; }
    function requireManagerAlert() { alert('IT Manager (Htet Aung Khant) တစ်ဦးတည်းသာ ပြင်ဆင်ခွင့်နှင့် ဖျက်ခွင့် ရှိပါသည်။'); }
    function getInitials(n) { return (n || 'U').split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase(); }

    function handleLogin(e) {
      e.preventDefault();
      const u = document.getElementById('login-username').value.trim().toLowerCase();
      const p = document.getElementById('login-password').value.trim();
      const found = db.users.find(a => a.username.toLowerCase() === u && a.password === p);
      if (!found) { document.getElementById('login-error').classList.remove('hidden'); return; }
      document.getElementById('login-error').classList.add('hidden');
      currentUser = found;
      localStorage.setItem('it_portal_current_user', JSON.stringify(currentUser));
      applyLoggedInUser();
    }

    function applyLoggedInUser() {
      if (!currentUser) { document.getElementById('login-screen').classList.remove('hidden'); return; }
      document.getElementById('login-screen').classList.add('hidden');
      document.getElementById('active-user-name').innerText = currentUser.name;
      document.getElementById('active-user-role').innerText = currentUser.role;
      document.getElementById('active-user-avatar').innerText = getInitials(currentUser.name);

      const rb = document.getElementById('role-permission-badge');
      rb.className = isManager() ? 'role-indicator role-manager' : 'role-indicator role-staff';
      rb.innerHTML = isManager() ? '<i class="fa-solid fa-crown"></i> Manager' : '<i class="fa-solid fa-lock"></i> Staff';

      document.getElementById('manager-add-user-form')?.classList.toggle('hidden', !isManager());
      document.getElementById('manager-clear-data-btn')?.classList.toggle('hidden', !isManager());

      document.getElementById('cctv-by').value = currentUser.name;
      document.getElementById('net-by').value = currentUser.name;
      renderAll();
    }

    function handleLogout() {
      currentUser = null;
      localStorage.removeItem('it_portal_current_user');
      document.getElementById('login-password').value = '';
      document.getElementById('app-sidebar')?.classList.remove('open');
      document.getElementById('login-screen').classList.remove('hidden');
    }

    async function addUserAccount(e) {
      e.preventDefault();
      if (!isManager()) return requireManagerAlert();
      const name = document.getElementById('new-u-name').value.trim();
      const username = document.getElementById('new-u-user').value.trim().toLowerCase();
      const password = document.getElementById('new-u-pass').value.trim();
      const role = document.getElementById('new-u-role').value;
      if (db.users.some(u => u.username.toLowerCase() === username)) return alert('Username ရှိပြီးသားဖြစ်ပါသည်!');
      db.users.push({ username, password, name, role });
      document.getElementById('new-u-name').value = '';
      document.getElementById('new-u-user').value = '';
      document.getElementById('new-u-pass').value = '';
      renderAll(); await pushToGitHub();
    }

    async function editUserAccount(idx) {
      if (!isManager()) return requireManagerAlert();
      const u = db.users[idx];
      const name = prompt('Edit Full Name:', u.name); if (!name) return;
      const password = prompt('Edit Password:', u.password); if (!password) return;
      const role = prompt('Edit Role:', u.role); if (!role) return;
      db.users[idx] = { ...u, name: name.trim(), password: password.trim(), role: role.trim() };
      renderAll(); await pushToGitHub();
    }

    async function deleteUserAccount(idx) {
      if (!isManager()) return requireManagerAlert();
      if (db.users.length <= 1) return;
      if (!confirm(`${db.users[idx].name} အကောင့်ကို ဖျက်ရန် သေချာပါသလား?`)) return;
      db.users.splice(idx, 1);
      renderAll(); await pushToGitHub();
    }

