      a.href = URL.createObjectURL(new Blob([content], { type: mime }));
      a.download = filename;
      a.click();
    }

    function exportChecksReport(filterType, autoPrint) {
      const list = filterType === 'ALL' ? db.dailyChecks : db.dailyChecks.filter(c => c.type === filterType);
      if (!list.length) return alert('Export ထုတ်ရန် စာရင်း မရှိသေးပါ!');

      const title = filterType === 'ALL' ? 'Daily Checks (CCTV & Network) Report' : `${filterType} Check Report (with Screenshots)`;
      const rowsHtml = list.map(c => {
        const photosHtml = (c.images && c.images.length)
          ? `<div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;">
               ${c.images.map(src => `<img src="${src}" style="height:150px;border-radius:8px;border:1px solid #cbd5e1;object-fit:cover;">`).join('')}
             </div>`
          : `<span style="color:#94a3b8;font-size:12px;">No screenshot</span>`;
        return `
          <tr>
            <td><b>${c.ticket || '-'}</b><br><span style="color:#64748b;font-size:12px;">${c.date}</span></td>
            <td><b>${c.type}</b></td>
            <td>${c.details || '-'}</td>
            <td><b>${c.status}</b></td>
            <td>${c.remark}<br>${photosHtml}</td>
            <td>${c.by}</td>
          </tr>`;
      }).join('');

      const htmlDoc = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>${title}</title>
        <style>
          body { font-family: 'Segoe UI', sans-serif; padding: 28px; color: #1e293b; }
          h1 { font-size: 22px; margin-bottom: 4px; }
          .meta { font-size: 12px; color: #64748b; margin-bottom: 18px; }
          table { width: 100%; border-collapse: collapse; font-size: 13px; }
          th, td { border: 1px solid #cbd5e1; padding: 10px; text-align: left; vertical-align: top; }
          th { background: #f1f5f9; }
          .print-bar { margin-bottom: 16px; display: flex; gap: 10px; }
          .btn { padding: 8px 16px; background: #2563eb; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; }
          @media print { .print-bar { display: none; } }
        </style></head><body>
        <div class="print-bar">
          <button class="btn" onclick="window.print()">Print / Save as PDF</button>
        </div>
        <h1>${title}</h1>
        <div class="meta">Generated on: ${new Date().toLocaleString()} | Total Records: ${list.length}</div>
        <table>
          <thead><tr><th>Ticket / Date</th><th>Type</th><th>Technical Details</th><th>Status</th><th>Remarks & Evidence Photos</th><th>Checked By</th></tr></thead>
          <tbody>${rowsHtml}</tbody>
        </table>
      </body></html>`;

      downloadFile(htmlDoc, `${filterType.toLowerCase()}-check-report-with-photos.html`, 'text/html;charset=utf-8');
      if (autoPrint) {
        const w = window.open('', '_blank');
        if (w) { w.document.write(htmlDoc); w.document.close(); }
      }
    }

