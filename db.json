            <td><code>${isManager() ? u.password : '••••••'}</code></td>
            <td><span class="badge ${u.role === 'IT Manager' ? 'b-amber' : 'b-blue'}">${u.role}</span></td>
            <td>${isManager()
              ? `<button onclick="editUserAccount(${idx})" class="action-btn action-
